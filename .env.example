# Copie para .env e preencha. Nunca versione o .env.
PORT=3333
# Chave de 32 bytes em base64 para cifrar CPF/RG: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
CONTRACT_KEY=
CLICKSIGN_HMAC_SECRET=
PIPEDRIVE_MODE=mock
MONDAY_MODE=mock
CLICKSIGN_MODE=mock
DRIVE_MODE=mock
# 1 liga as rotas de demonstração (/api/demo/*). Nunca em produção.
DEMO_MODE=0
# Pasta do banco. Fora de pastas sincronizadas (Google Drive/OneDrive): elas criam arquivos que corrompem o banco.
DATA_DIR=./data

# Pipedrive (conector real). Token de API e domínio da conta (ex.: suaempresa.pipedrive.com)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
